#!/bin/bash
# kbd-idle-daemon: Dell-style keyboard backlight for ASUS laptops on Linux.
#
# Turns the kbd backlight ON when you type or touch the touchpad (at the level
# last set via Fn+F3/F4), and OFF after IDLE_SECS seconds without activity.
#
# Handles suspend/resume: the ASUS EC clears the backlight on resume, which the
# kernel reports via the LED's brightness_hw_changed uevent. That same uevent
# fires on Fn+F3/F4 presses, so one udev watcher covers both manual changes and
# EC resets.

IDLE_SECS="${IDLE_SECS:-30}"
LED_PATH="/sys/class/leds/asus::kbd_backlight"
STATE_FILE=/run/kbd-idle-level

# Find input devices: prefer the keyd virtual keyboard if keyd is running
# (keyd grabs the physical keyboard), otherwise fall back to the i8042
# keyboard. Also watch the touchpad (keyd does not grab pointer devices).
KBD_DEV=""
TPAD_DEV=""
for e in /sys/class/input/event*/device/name; do
  [[ -e $e ]] || continue
  name=$(cat "$e" 2>/dev/null)
  dev="/dev/input/$(basename "$(dirname "$(dirname "$e")")")"
  case $name in
    "keyd virtual keyboard") KBD_DEV=$dev ;;
    *Touchpad*|*TouchPad*)   TPAD_DEV=$dev ;;
  esac
done
if [[ -z $KBD_DEV ]]; then
  KBD_DEV="/dev/input/by-path/platform-i8042-serio-0-event-kbd"
fi

if [[ ! -e $LED_PATH || ! -e $KBD_DEV ]]; then
  echo "kbd-idle-daemon: missing $LED_PATH or $KBD_DEV" >&2
  exit 1
fi

echo "kbd-idle-daemon: watching keyboard=$KBD_DEV touchpad=${TPAD_DEV:-none}, idle timeout ${IDLE_SECS}s" >&2

LIT_FLAG=/run/kbd-idle-lit
LAST_EVENT_FILE=$(mktemp /run/kbd-idle-last.XXXXXX)
echo "$EPOCHSECONDS" > "$LAST_EVENT_FILE"

relight() {
  local level
  level=$(cat "$STATE_FILE" 2>/dev/null || echo 0)
  if (( level > 0 )); then
    echo "$level" > "$LED_PATH/brightness" 2>/dev/null
    touch "$LIT_FLAG"
  fi
}

# Saved level defaults to current brightness (or 1 if currently off).
cur=$(cat "$LED_PATH/brightness" 2>/dev/null || echo 0)
if (( cur > 0 )); then
  echo "$cur" > "$STATE_FILE"
  touch "$LIT_FLAG"
else
  [[ -e $STATE_FILE ]] || echo 1 > "$STATE_FILE"
  rm -f "$LIT_FLAG"
fi

# Record keyboard/touchpad activity: bump timestamp and relight if dark
# (unless saved level is 0, meaning the user turned the backlight off).
on_activity() {
  echo "$EPOCHSECONDS" > "$LAST_EVENT_FILE"
  [[ -e $LIT_FLAG ]] || relight
}

# Each 24-byte input_event read = device activity.
watcher() {
  local dev=$1
  while true; do
    while dd if="$dev" bs=24 count=1 status=none iflag=fullblock of=/dev/null 2>/dev/null; do
      on_activity
    done
    sleep 1
  done
}

# Hardware-change watcher: the EC reports kbd backlight changes (Fn keys,
# resume-from-sleep resets) via the brightness_hw_changed uevent.
# - hw level > 0  -> user pressed Fn+F3/F4 (or firmware restored a level):
#                    adopt it as the saved level and mark lit.
# - hw level == 0 -> user pressed Fn+F3 down to 0 (save "off"), OR the EC
#                    cleared the light across suspend/resume: relight if the
#                    user never asked for off.
hw_watcher() {
  udevadm monitor --udev --subsystem-match=leds 2>/dev/null | while read -r line; do
    [[ $line == *"asus::kbd_backlight"* ]] || continue
    sleep 0.2   # let the sysfs brightness settle
    hw=$(cat "$LED_PATH/brightness" 2>/dev/null || echo 0)
    if (( hw > 0 )); then
      echo "$hw" > "$STATE_FILE"
      echo "$EPOCHSECONDS" > "$LAST_EVENT_FILE"
      touch "$LIT_FLAG"
    elif [[ -e $LIT_FLAG ]]; then
      # We believed it was lit but the hw went dark without our doing:
      # either a manual Fn-off (saved level already matches 0 intent) or an
      # EC reset across resume. If saved level > 0, the user wanted light.
      level=$(cat "$STATE_FILE" 2>/dev/null || echo 0)
      if (( level > 0 )); then
        relight   # EC cleared it (e.g. resume): restore.
      else
        rm -f "$LIT_FLAG"   # genuine manual off
      fi
    fi
  done
}

watcher "$KBD_DEV" &
WATCHER_PIDS="$!"
if [[ -n $TPAD_DEV && -e $TPAD_DEV ]]; then
  watcher "$TPAD_DEV" &
  WATCHER_PIDS="$WATCHER_PIDS $!"
fi
hw_watcher &
WATCHER_PIDS="$WATCHER_PIDS $!"

cleanup() {
  kill $WATCHER_PIDS 2>/dev/null
  rm -f "$LAST_EVENT_FILE" "$LIT_FLAG"
}
trap cleanup EXIT

# Idle checker: turns the light off after IDLE_SECS without activity.
# Note: our own writes to brightness do NOT trigger brightness_hw_changed,
# so this loop cannot fight the hw_watcher.
while true; do
  sleep 2
  last=$(cat "$LAST_EVENT_FILE" 2>/dev/null || echo 0)
  if [[ -e $LIT_FLAG ]] && (( EPOCHSECONDS - last >= IDLE_SECS )); then
    cur=$(cat "$LED_PATH/brightness" 2>/dev/null || echo 0)
    if (( cur > 0 )); then
      echo "$cur" > "$STATE_FILE"
      echo 0 > "$LED_PATH/brightness"
    fi
    rm -f "$LIT_FLAG"
  fi
done

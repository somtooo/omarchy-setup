#!/bin/bash
# kbd-idle-daemon: Dell-style keyboard backlight for ASUS laptops on Linux.
#
# Control law, evaluated continuously:
#
#     b(t) = L   if L > 0 and (now - last_input) < IDLE_SECS
#     b(t) = 0   otherwise
#
# L = the user's chosen level (persisted in STATE_FILE). L = 0 means the
# user turned the backlight off; the daemon then leaves it off until the
# user picks a nonzero level again (Fn keys / any external write).
#
# External changes (Fn keys, EC reset on resume, brightnessctl, asusctl)
# are adopted on the next tick: a nonzero b != L becomes the new L, and a
# zero b while the user is active becomes L = 0. No flags, no edge
# detection — the loop is idempotent and converges from any disturbance.

IDLE_SECS="${IDLE_SECS:-30}"
LED_PATH="/sys/class/leds/asus::kbd_backlight"
STATE_FILE=/run/kbd-idle-level
LAST_EVENT_FILE=/run/kbd-idle-last

# Find input devices: prefer the keyd virtual keyboard if keyd is running
# (keyd grabs the physical keyboard), otherwise fall back to the i8042
# keyboard. Also watch the touchpad (keyd does not grab pointer devices).
KBD_DEV=""
TPAD_DEV=""
for e in /sys/class/input/event*/device/name; do
  [[ -e $e ]] || continue
  name=$(cat "$e" 2>/dev/null)
  dev="/dev/input/$(basename "$(dirname "$(dirname "$e")")")"
  case $name in
    "keyd virtual keyboard") KBD_DEV=$dev ;;
    *Touchpad*|*TouchPad*)   TPAD_DEV=$dev ;;
  esac
done
if [[ -z $KBD_DEV ]]; then
  KBD_DEV="/dev/input/by-path/platform-i8042-serio-0-event-kbd"
fi

if [[ ! -e $LED_PATH || ! -e $KBD_DEV ]]; then
  echo "kbd-idle-daemon: missing $LED_PATH or $KBD_DEV" >&2
  exit 1
fi

echo "kbd-idle-daemon: watching keyboard=$KBD_DEV touchpad=${TPAD_DEV:-none}, idle timeout ${IDLE_SECS}s" >&2

get_b() { local v; v=$(cat "$LED_PATH/brightness" 2>/dev/null); echo "${v:-0}"; }
set_b() { echo "$1" > "$LED_PATH/brightness" 2>/dev/null; }
get_L() { local v; v=$(cat "$STATE_FILE" 2>/dev/null); echo "${v:-1}"; }
set_L() { echo "$1" > "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"; }
last_event() { local v; v=$(cat "$LAST_EVENT_FILE" 2>/dev/null); echo "${v:-$EPOCHSECONDS}"; }
stamp() { echo "$EPOCHSECONDS" > "$LAST_EVENT_FILE.tmp" && mv "$LAST_EVENT_FILE.tmp" "$LAST_EVENT_FILE"; }

# Initialize: adopt current brightness as the level (default 1 if dark).
b=$(get_b)
if (( b > 0 )); then set_L "$b"; else [[ -e $STATE_FILE ]] || set_L 1; fi
stamp

# Input watchers: each 24-byte input_event read = activity. Just stamp the
# clock; the control loop does the rest on its next tick.
watcher() {
  local dev=$1
  while true; do
    while dd if="$dev" bs=24 count=1 status=none iflag=fullblock of=/dev/null 2>/dev/null; do
      stamp
    done
    sleep 1
  done
}

watcher "$KBD_DEV" &
PIDS="$!"
if [[ -n $TPAD_DEV && -e $TPAD_DEV ]]; then
  watcher "$TPAD_DEV" &
  PIDS="$PIDS $!"
fi

cleanup() { kill $PIDS 2>/dev/null; rm -f "$LAST_EVENT_FILE" "$LAST_EVENT_FILE.tmp" "$STATE_FILE.tmp"; }
trap cleanup EXIT

# Control loop.
# Start with we_turned_it_off=1: darkness present at startup (boot, service
# restart after a crash, resume with a fresh process) is system-caused, not
# a manual user-off, so it must never zero L.
we_turned_it_off=1
prev_now=$EPOCHSECONDS
while true; do
  sleep 2
  b=$(get_b)
  L=$(get_L)
  le=$(last_event)
  a=$(( EPOCHSECONDS - le ))

  # Suspend/resume detection: wall clock jumped far beyond our sleep interval.
  # Treat any current darkness as system-caused (EC clears the backlight on
  # resume), not as a manual user-off.
  if (( EPOCHSECONDS - prev_now > IDLE_SECS )); then
    we_turned_it_off=1
  fi
  prev_now=$EPOCHSECONDS

  # Adopt external changes.
  if (( b > 0 && b != L )); then
    set_L "$b"; L=$b
  elif (( b == 0 && L > 0 && a < IDLE_SECS && we_turned_it_off == 0 )); then
    # Active user, light went dark, we didn't do it: user turned it off.
    set_L 0; L=0
  fi

  # Enforce the control law.
  if (( L > 0 && a < IDLE_SECS )); then desired=$L; else desired=0; fi
  if (( b != desired )); then
    set_b "$desired"
    # Remember "we turned it off" until we relight, so darkness we created
    # is not mistaken for a manual user-off on a later tick.
    if (( desired == 0 )); then we_turned_it_off=1; fi
  fi
  if (( we_turned_it_off == 1 && desired > 0 && b == 0 )); then
    # We just relit (this tick or a prior one): flag has served its purpose.
    we_turned_it_off=0
  fi
done

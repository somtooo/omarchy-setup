#!/bin/bash
# kbd-idle-daemon: Dell-style keyboard backlight for ASUS laptops on Linux.
#
# Behavior:
#   - Any keyboard or touchpad activity turns the backlight ON at level L.
#   - IDLE_SECS without activity turns it OFF.
#   - L changes ONLY via omarchy-brightness-keyboard (Super+F2/F3), through
#     the shim at /usr/local/bin which records intent to INTENT_FILE.
#     L = 0 means the user turned the backlight off; it then stays off
#     (even while typing) until the user raises it again.
#
# The daemon NEVER writes L itself: external brightness changes (EC resets
# on suspend/lid, brightnessctl, Fn keys handled in hardware) cannot corrupt
# user intent — they only affect the current hardware level until the next
# input event re-asserts L.

IDLE_SECS="${IDLE_SECS:-30}"
LED_PATH="/sys/class/leds/asus::kbd_backlight"
LAST_EVENT_FILE=/run/kbd-idle-last

# Find the intent file (written by the omarchy-brightness-keyboard shim in
# the user's runtime dir). Re-resolve every read: the shim may appear after
# the daemon starts.
get_L() {
  local v
  for d in /run/user/*; do
    if [[ -e $d/kbd-backlight-intent ]]; then
      v=$(cat "$d/kbd-backlight-intent" 2>/dev/null)
      break
    fi
  done
  # No recorded intent yet: adopt whatever the hardware currently shows.
  [[ -z $v ]] && v=$(get_b)
  echo "${v:-1}"
}

# Find input devices: prefer the keyd virtual keyboard if keyd is running
# (keyd grabs the physical keyboard), otherwise fall back to the i8042
# keyboard. Also watch the touchpad (keyd does not grab pointer devices).
KBD_DEV=""
TPAD_DEV=""
for e in /sys/class/input/event*/device/name; do
  [[ -e $e ]] || continue
  name=$(cat "$e" 2>/dev/null)
  dev="/dev/input/$(basename "$(dirname "$(dirname "$e")")")"
  case $name in
    "keyd virtual keyboard") KBD_DEV=$dev ;;
    *Touchpad*|*TouchPad*)   TPAD_DEV=$dev ;;
  esac
done
if [[ -z $KBD_DEV ]]; then
  KBD_DEV="/dev/input/by-path/platform-i8042-serio-0-event-kbd"
fi

if [[ ! -e $LED_PATH || ! -e $KBD_DEV ]]; then
  echo "kbd-idle-daemon: missing $LED_PATH or $KBD_DEV" >&2
  exit 1
fi

echo "kbd-idle-daemon: watching keyboard=$KBD_DEV touchpad=${TPAD_DEV:-none}, idle timeout ${IDLE_SECS}s" >&2

get_b() { local v; v=$(cat "$LED_PATH/brightness" 2>/dev/null); echo "${v:-0}"; }
set_b() { echo "$1" > "$LED_PATH/brightness" 2>/dev/null; }
last_event() { local v; v=$(cat "$LAST_EVENT_FILE" 2>/dev/null); echo "${v:-$EPOCHSECONDS}"; }

# Watcher: each 24-byte input_event read = activity. Stamp the clock, then
# relight ONLY if the light is currently off — never touch a lit backlight,
# so brightness changes (Super+F2/F3) are never fought.
watcher() {
  local dev=$1 tmp="$LAST_EVENT_FILE.w$$"
  while true; do
    while dd if="$dev" bs=24 count=1 status=none iflag=fullblock of=/dev/null 2>/dev/null; do
      echo "$EPOCHSECONDS" > "$tmp" && mv -f "$tmp" "$LAST_EVENT_FILE"
      if (( $(get_b) == 0 )); then
        L=$(get_L)
        (( L > 0 )) && set_b "$L"
      fi
    done
    sleep 1
  done
}

watcher "$KBD_DEV" &
PIDS="$!"
if [[ -n $TPAD_DEV && -e $TPAD_DEV ]]; then
  watcher "$TPAD_DEV" &
  PIDS="$PIDS $!"
fi

cleanup() { kill $PIDS 2>/dev/null; rm -f "$LAST_EVENT_FILE" "$LAST_EVENT_FILE".*; }
trap cleanup EXIT

# Tick loop: enforces the idle timeout only.
while true; do
  sleep 2
  b=$(get_b)
  a=$(( EPOCHSECONDS - $(last_event) ))
  if (( b > 0 && a >= IDLE_SECS )); then
    set_b 0
  fi
done

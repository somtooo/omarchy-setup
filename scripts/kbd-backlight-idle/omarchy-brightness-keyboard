#!/bin/bash
# Shim for omarchy-brightness-keyboard (Fn keyboard-brightness keys).
# Runs the real command, then records the resulting level as the user's
# intent for kbd-idle-daemon. This file is the ONLY writer of intent:
# L = 0 means the user turned the backlight off; any other value is the
# level to relight at. Written to the user's runtime dir so no root needed.

REAL=/usr/share/omarchy/bin/omarchy-brightness-keyboard
INTENT_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

"$REAL" "$@"
rc=$?

level=$(cat /sys/class/leds/asus::kbd_backlight/brightness 2>/dev/null)
[[ -n $level ]] && echo "$level" > "$INTENT_DIR/kbd-backlight-intent" 2>/dev/null

exit $rc

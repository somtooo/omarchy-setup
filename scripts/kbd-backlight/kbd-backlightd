#!/usr/bin/env python3
"""kbd-backlightd: Dell-style keyboard backlight for ASUS laptops on Linux.

One process, one thread, one selector event loop. All state lives in memory
here; every event (input, command, timer) is processed atomically, one at a
time, so races are impossible by construction.

State:
    L           the user's chosen level (0..MAX). Written ONLY by the
                up/down/off commands received on the control socket.
                Persisted to disk (atomically) only when it changes.
    last_input  timestamp of the last keyboard/touchpad event.
    last_wrote  the last value this daemon wrote to the LED (int), or None
                when out of control (after sleep). Never a cache of what the
                register says — the EC can change the register unobserved.

All EC communication is direct sysfs (asus-nb-wmi driver → ACPI WMI → EC).
asusctl was tested as an alternative transport and rejected: it adds a D-Bus
round-trip but reaches the EC through the identical WMI method, and the EC
drops its writes exactly the same way. Only the EC's internal Fn-key path is
immune, and Linux cannot trigger that path.

Normal operation is pure cache trust: typing costs zero EC traffic.
After sleep, a settle phase (SETTLE_SECS: touch nothing, let the EC finish)
is followed by timer-driven send+check rounds with growing waits
(SETTLE, SETTLE+5, …) until `asusctl leds get` agrees with L. Commands always
write through, even in these phases.
"""

import os
import selectors
import socket
import struct
import sys
import time

RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/run/user/1000")
STATE_HOME = "/var/lib/kbd-backlightd"

IDLE_SECS = int(os.environ.get("IDLE_SECS", "30"))
SETTLE_SECS = int(os.environ.get("SETTLE_SECS", "2"))
RETRY_STEP_SECS = int(os.environ.get("RETRY_STEP_SECS", "1"))
LED_SYSFS = "/sys/class/leds/asus::kbd_backlight"
LED_PATH = f"{LED_SYSFS}/brightness"
MAX_LEVEL = int(open(f"{LED_SYSFS}/max_brightness").read())
STATE_FILE = os.path.join(STATE_HOME, "level")
SOCKET_PATH = os.path.join(RUNTIME, "kbd-backlightd.sock")

INPUT_EVENT = struct.Struct("qqHHi")  # sec, usec, type, code, value


def log(msg: str) -> None:
    print(f"kbd-backlightd: {msg}", file=sys.stderr, flush=True)


def read_led() -> int:
    try:
        with open(LED_PATH) as f:
            return int(f.read())
    except (OSError, ValueError):
        return -1  # unparseable: never equals a real level, forces retry


def write_led(level: int) -> None:
    try:
        with open(LED_PATH, "w") as f:
            f.write(str(level))
    except OSError as e:
        log(f"LED write failed: {e}")


def load_L() -> int:
    try:
        with open(STATE_FILE) as f:
            return max(0, min(MAX_LEVEL, int(f.read())))
    except (OSError, ValueError):
        b = read_led()  # first run: adopt current hardware level
        return max(0, min(MAX_LEVEL, b)) if b >= 0 else 1


def save_L(level: int) -> None:
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w") as f:
        f.write(str(level))
    os.replace(tmp, STATE_FILE)


def find_input_devices() -> list[str]:
    """keyd virtual keyboard if keyd runs (it grabs the physical keyboard),
    else the i8042 keyboard; plus the touchpad (keyd never grabs pointers)."""
    kbd = tpad = None
    for entry in os.listdir("/sys/class/input"):
        if not entry.startswith("event"):
            continue
        try:
            with open(f"/sys/class/input/{entry}/device/name") as f:
                name = f.read().strip().lower()
        except OSError:
            continue
        if name == "keyd virtual keyboard":
            kbd = f"/dev/input/{entry}"
        elif "touchpad" in name:
            tpad = f"/dev/input/{entry}"
    if kbd is None:
        kbd = "/dev/input/by-path/platform-i8042-serio-0-event-kbd"
    return [d for d in (kbd, tpad) if d]


def main() -> None:
    # Wait for the user's runtime dir (may not exist yet at early boot).
    for _ in range(120):
        if os.path.isdir(RUNTIME):
            break
        time.sleep(1)

    L = load_L()
    last_input = time.monotonic()
    # Believe what the register shows at startup (e.g. systemd-backlight
    # restored a level at boot) so the idle timer applies to it.
    last_wrote = read_led()
    retry_at = None  # next scheduled send+check round (monotonic), or None
    retry_wait = SETTLE_SECS  # current wait; grows by RETRY_STEP_SECS per round
    log(f"start: L={L} register={last_wrote}")

    sel = selectors.DefaultSelector()

    try:
        os.unlink(SOCKET_PATH)
    except FileNotFoundError:
        pass
    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    srv.bind(SOCKET_PATH)
    # Socket lives in the user's runtime dir (mode 700), so only that user
    # can reach it; 0666 lets the user-owned client talk to this root daemon.
    os.chmod(SOCKET_PATH, 0o666)
    srv.listen()
    srv.setblocking(False)
    sel.register(srv, selectors.EVENT_READ, "cmd")

    def open_inputs() -> None:
        for dev in find_input_devices():
            try:
                fd = os.open(dev, os.O_RDONLY | os.O_NONBLOCK)
            except OSError as e:
                log(f"cannot open {dev}: {e}")
                continue
            sel.register(fd, selectors.EVENT_READ, "input")
            log(f"watching {dev} (fd {fd})")

    def close_inputs() -> None:
        for key in list(sel.get_map().values()):
            if key.data == "input":
                try:
                    sel.unregister(key.fileobj)
                    os.close(key.fileobj)
                except (OSError, KeyError):
                    pass

    def check_round() -> None:
        """One send+check round: read the register and compare against L
        (not zero — any level the daemon didn't write means interference).
        On mismatch, write L and schedule the next round with a LONGER wait
        (waits grow 10, 15, 20… so EC traffic decreases over time, never
        accelerates). Repeats until the register agrees or the user walks
        away (idle cancels the cycle)."""
        nonlocal retry_at, retry_wait, last_wrote
        if L == 0:
            retry_at = None  # nothing to send; dark is correct
            return
        b = read_led()
        if b == L:
            last_wrote = L
            retry_at = None
            log(f"recovered: register confirmed {L}, in control")
        else:
            write_led(L)
            retry_wait += RETRY_STEP_SECS
            retry_at = time.monotonic() + retry_wait
            log(f"retry: register was {b}, wrote {L}, next check in {retry_wait}s")

    def on_input() -> None:
        nonlocal last_input, last_wrote, retry_at
        now = time.monotonic()
        last_input = now
        if L == 0:
            return
        if retry_at is not None:
            # Retry cycle active (post-resume): the timer drives send+check
            # rounds. Keystrokes only refresh the idle clock — zero EC traffic.
            return
        if last_wrote is None:
            # Out of control with no cycle (e.g. after idle-cancel): round now.
            check_round()
        elif last_wrote != L:
            # Normal operation: cache is trustworthy (no sleep happened), so
            # write blind — no read. The post-resume retry cycle is the only
            # place that reads before writing.
            write_led(L)
            last_wrote = L
            log(f"relight: wrote {L}")

    def on_command() -> None:
        nonlocal L, last_input, last_wrote
        last_input = time.monotonic()  # the keypress that sent this is input
        conn, _ = srv.accept()
        try:
            msg = conn.recv(16).decode().strip()
            old = L
            if msg == "up":
                L = min(MAX_LEVEL, L + 1)
            elif msg == "down":
                L = max(0, L - 1)
            elif msg == "off":
                L = 0
            else:
                log(f"unknown command: {msg!r}")
                return
            if L != old:
                save_L(L)
            write_led(L)  # unconditional: a deliberate press should always apply
            last_wrote = L
            # A running retry cycle will verify this write on its next round;
            # leave retry_at alone.
            log(f"command {msg}: L {old} -> {L}")
            # Reply with the level: the client (running in the user session)
            # shows the OSD — root can't reach the Wayland socket.
            conn.sendall(str(L).encode())
        finally:
            conn.close()

    # Resume detection: time.monotonic() freezes during deep sleep while wall
    # clock (time.time()) keeps running. A jump in their delta = we slept.
    # Real suspends shift the delta by minutes; small shifts (NTP slew,
    # scheduler stalls) must not trigger this.
    wall_mono_delta = time.time() - time.monotonic()

    open_inputs()

    while True:
        new_delta = time.time() - time.monotonic()
        if abs(new_delta - wall_mono_delta) > 5.0:
            # We slept. Schedule the first send+check round SETTLE_SECS out:
            # until then, touch nothing and let the EC finish whatever it's
            # doing. The round reads first and writes only on mismatch; later
            # rounds wait progressively longer (SETTLE, +RETRY_STEP each time)
            # so EC traffic only decreases.
            log(f"resume detected (clock delta jumped {new_delta - wall_mono_delta:+.1f}s); "
                f"first check in {SETTLE_SECS}s")
            wall_mono_delta = new_delta
            last_wrote = None
            last_input = time.monotonic()  # pre-sleep idle time doesn't count
            retry_wait = SETTLE_SECS
            retry_at = time.monotonic() + retry_wait

        lit = isinstance(last_wrote, int) and last_wrote > 0
        now = time.monotonic()
        deadlines = []
        if lit:
            deadlines.append(last_input + IDLE_SECS)
        if retry_at is not None:
            deadlines.append(retry_at)
        timeout = max(0.0, min(deadlines) - now) if deadlines else None

        for key, _ in sel.select(timeout):
            if key.data == "input":
                try:
                    while os.read(key.fileobj, INPUT_EVENT.size):
                        pass
                except BlockingIOError:
                    pass
                except OSError as e:
                    # Dead device (e.g. keyd restarted onto a new event node):
                    # drop it so select stops returning it, then re-scan.
                    log(f"input fd {key.fileobj} died: {e}; re-scanning")
                    close_inputs()
                    open_inputs()
                    continue
                on_input()
            else:
                on_command()

        now = time.monotonic()
        if now - last_input >= IDLE_SECS:
            # User walked away: stop any retry cycle — pointless to keep
            # sending while nobody is here. Next keystroke restarts it.
            retry_at = None
        if retry_at is not None and now >= retry_at:
            check_round()
            # recompute: the round may have set last_wrote / cleared retry_at
            lit = isinstance(last_wrote, int) and last_wrote > 0
        if lit and now - last_input >= IDLE_SECS:
            log(f"idle {IDLE_SECS}s: wrote 0 (L stays {L})")
            write_led(0)
            last_wrote = 0


if __name__ == "__main__":
    main()

[Plymouth Theme]
Name=Beautiful
Description=Quattro orb splash - wallpaper circle, frosted pill password field
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/beautiful
ScriptFile=/usr/share/plymouth/themes/beautiful/beautiful.script
ConsoleLogBackgroundColor=0x1a1b26
MonospaceFont=Cantarell 11
Font=Cantarell 11
